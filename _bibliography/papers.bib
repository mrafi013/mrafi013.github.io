@inproceedings{rafique2025milcom,
  title        = {Investigation of {STEEP} Using Phase-Shift-Keying Signaling for Secure Communications},
  author       = {Rafique, Moontasir and Hua, Yingbo},
  booktitle    = {Proceedings of the IEEE Military Communications Conference (MILCOM)},
  year         = {2025},
  address      = {Los Angeles, CA, USA},
  selected     = {true},
  abbr         = {MILCOM},
  abstract     = {This paper investigates the STEEP physical-layer security protocol using
                  phase-shift-keying (PSK) signaling, deriving secret-key capacity and secrecy rate
                  for finite PSK constellations and evaluating performance under hard and soft
                  detection at both the legitimate receiver and eavesdropper.}
}

@inproceedings{rafique2026scsetech,
  title        = {Domain-Adversarial Adaptation for Robust {RIS} Beam Selection Under Propagation Shifts},
  author       = {Rafique, Moontasir and Hua, Yingbo},
  booktitle    = {Proceedings of the IEEE SCSETech},
  year         = {2026},
  address      = {Pomona, CA, USA},
  note         = {Submitted},
  selected     = {true},
  abbr         = {SCSETech},
  abstract     = {We develop a domain-adversarial neural network (DANN) framework for RIS beam selection
                  under LOS-to-NLOS domain shift. Using MLP and CNN backbones trained on 3GPP-compliant
                  geometry-based stochastic channel datasets, we show that semi-supervised domain adaptation
                  with 30% labeled target data substantially recovers accuracy over no-adaptation baselines.}
}

